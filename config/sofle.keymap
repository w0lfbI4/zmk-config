// Подключаем библиотеку мыши для работы нативного скролла

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Кастомные настройки для плавной прокрутки

    behaviors {
        // Левый энкодер: нативный скролл мыши с задержкой под стандартные 3 строчки
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                              &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS
&kp GRAVE  &kp Q   &kp W     &kp E     &kp R      &kp T                               &kp Y      &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A   &kp S     &kp D     &kp F      &kp G                               &kp H      &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V      &kp B      &kp C_MUTE    &kp EQUAL  &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp EQUAL
                   &kp LGUI  &kp LALT  &kp LCTRL  &mo LOWER  &kp SPACE     &kp RET    &mo RAISE  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            // Заменили резкий PG_UP/PG_DN на плавное поведение left_encoder_scroll.
            // Правый энкодер по-прежнему управляет громкостью (хоть правая половина пока и отключена)

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";
            bindings = <
&kp EQUAL  &kp F1       &kp F2     &kp F3     &kp F4    &kp F5                       &kp F6     &kp F7    &kp F8     &kp F9        &kp F10   &kp F11
&kp GRAVE  &kp N1       &kp N2     &kp N3     &kp N4    &kp N5                       &kp N6     &kp N7    &kp N8     &kp N9        &kp N0    &kp F12
&trans     &kp EXCL     &kp AT     &kp HASH   &kp DLLR  &kp PRCNT                    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR      &kp RPAR  &kp PIPE
&trans     &kp KP_PLUS  &kp MINUS  &kp UNDER  &kp LBRC  &kp RBRC   &trans    &trans  &kp LBKT   &kp RBKT  &kp FSLH   &kp LS(FSLH)  &kp BSLH  &trans
                        &trans     &trans     &trans    &trans     &trans    &trans  &trans     &trans    &trans     &trans
            >;
        };

        raise_layer {
            display-name = "raise";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans     &kp KP_NUM  &kp SLASH     &kp ASTERISK  &trans   &trans
&trans      &kp INS       &kp UP        &kp K_CMENU   &trans        &trans                          &kp PG_UP  &kp N7      &kp NUMBER_8  &kp N9        &kp N0   &trans
&trans      &kp LEFT      &kp DOWN      &kp RIGHT     &trans        &kp CLCK                        &kp PG_DN  &kp N4      &kp N5        &kp N6        &kp DEL  &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans        &trans    &trans  &trans     &kp N1      &kp N2        &kp N3        &trans   &trans
                          &trans        &trans        &trans        &trans        &trans    &trans  &trans     &trans      &kp N0        &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT &inc_dec_kp DOWN UP>;
        };

        adjust_layer {
            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                               &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                            &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                                      &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &rgb_ug RGB_TOG    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none              &none  &none  &none  &none  &none
            >;
        };
    };
};
